# Nusxa ko'chiring: copy .env.example .env
# vLLM server manzili (WSL2 yoki remote Linux server)
EISVO_VLLM_BASE_URL=http://localhost:8000/v1
EISVO_LLM_MODEL=Qwen/Qwen3-14B-AWQ

# OCR sozlamalari
EISVO_PDF_DPI=300
EISVO_LOW_CONF_THRESHOLD=0.70

# ── EISVO API (ID orqali shartnoma olish; JSON yuklash o'rniga) ──────────────
# POST endpoint to'liq URL (bo'sh bo'lsa — web'da ID input ishlamaydi, JSON yuklash qoladi)
EISVO_API_URL=
# Bearer token — WSL'dagi curl skriptidan olib shu yerga qo'ying (muddati tugasa yangilang)
EISVO_API_TOKEN=
# So'rov body'si — data/api_body.json fayliga (konteynerda /data). IKKI usul:
#  USUL A (tavsiya): Swagger'dagi BUTUN body'ni nusxalang, ID turadigan joyga {{id}} yozing.
#     mas: {"contractorId": "{{id}}", "lang": "ru"}  — maydon nomi qanday bo'lsa ham ishlaydi.
#     Bu holda EISVO_API_ID_FIELD kerak emas.
#  USUL B: bo'sh qoldiring yoki faqat QOLGAN maydonlarni yozing; ID quyidagi nom bilan
#     yuqori darajaga qo'shiladi:
EISVO_API_ID_FIELD=idn
EISVO_API_BODY_FILE=/data/api_body.json
# ...yoki fayl o'rniga inline JSON (mas: EISVO_API_BODY={"contractorId":"{{id}}"})
EISVO_API_BODY=

# ════════════════════════════════════════════════════════════════════════════
#  AI CHATBOT (lex.uz qonunchilik RAG) — tr_chatbot repodan birlashtirildi
# ════════════════════════════════════════════════════════════════════════════
# LLM: shu loyihaning `vllm` servisi (Qwen3-14B-AWQ). Alohida 8050 server EMAS.
VLLM_API_URL=http://vllm:8000/v1
VLLM_MODEL_NAME=Qwen/Qwen3-14B-AWQ
VLLM_TIMEOUT=120
VLLM_MAX_TOKENS=1024
VLLM_TEMPERATURE=0.2
# Qwen3 system rolini QO'LLAB-QUVVATLAYDI (gemma yo'q edi) -> true.
LLM_SUPPORTS_SYSTEM_ROLE=true
# Qwen3 "thinking" (<think>...</think>) ni o'chirish -> false.
LLM_ENABLE_THINKING=false
# Kontekst budjeti (belgi). Qwen3 bu yerda --max-model-len 20480 token.
LLM_CONTEXT_CHAR_BUDGET=18000

# Embedding (indexer + rag_backend). GPU vllm+surya bilan band bo'lgani uchun CPU'da.
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=16
MAX_CHUNK_CHARS=1200
CHUNK_OVERLAP_CHARS=150
MAX_CONTEXT_CHARS=3000

# PostgreSQL (chat sessiya/tarixi). PASSWORD majburiy — o'zingiznikini qo'ying.
POSTGRES_DB=tr_chatbot
POSTGRES_USER=tr_chatbot
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=postgres
POSTGRES_PORT=5433
POSTGRES_PORT_INTERNAL=5432

# Qdrant (vektor bazasi). HOST = docker servis nomi.
QDRANT_HOST=qdrant
QDRANT_PORT=6565
QDRANT_PORT_INTERNAL=6565
QDRANT_COLLECTION=tr_legal_docs_v1

# Scraper / Indexer
LEX_UZ_BASE_URL=https://lex.uz
SCRAPE_INTERVAL_HOURS=12
DOCUMENT_LIST_PATH=/app/document_urls.txt
INDEX_INTERVAL_MINUTES=30
REINDEX_ALL=false

# Backend (rag_backend :8008)
BACKEND_PORT=8008
# Chatni web (8080) server-side proksi qiladi, shuning uchun '*' yetarli.
ALLOWED_ORIGINS=*
RETRIEVAL_SCORE_THRESHOLD=0.80
HISTORY_TURNS_IN_PROMPT=3
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_MAX_TOKENS=120
QUERY_REWRITE_MAX_CHARS=300

# Sessiya cookie
SESSION_COOKIE_NAME=tr_chatbot_uid
SESSION_COOKIE_MAX_AGE_DAYS=365
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=false
